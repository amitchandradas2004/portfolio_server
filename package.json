  "version": "1.0.0",
  "description": "Backend API server for portfolio application with Admin and Demo role authentication",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "clean": "rimraf dist"
  },
  "keywords": [
    "nodejs",
    "typescript",
